# FMP Teleprompter — configuração do nginx dentro do contêiner.
# ${PORT} é substituído pelo entrypoint oficial da imagem nginx.

# Cache por tipo de conteúdo. Os arquivos não têm hash no nome, então o HTML,
# o CSS e o JS revalidam sempre (ETag devolve 304, é barato) para que um novo
# deploy apareça na hora. Imagens e fontes podem ficar em cache por uma semana.
map $sent_http_content_type $fmp_cache_control {
    default                "no-cache";
    ~^image/               "public, max-age=604800";
    ~^font/                "public, max-age=604800";
    ~application/font      "public, max-age=604800";
}

server {
    listen       ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;
    charset utf-8;

    # Atrás do proxy do EasyPanel: não reescrever redirecionamentos com a porta interna.
    absolute_redirect off;
    port_in_redirect  off;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   512;
    gzip_comp_level   6;
    gzip_types        text/plain text/css text/javascript application/javascript
                      application/json application/manifest+json image/svg+xml;

    # --- Cabeçalhos ---------------------------------------------------------
    # Todos ficam no nível do server: um add_header dentro de location
    # descartaria estes, por isso as locations abaixo não adicionam nenhum.
    add_header Cache-Control        $fmp_cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy      no-referrer always;

    # Câmera, microfone e wake lock precisam ser liberados explicitamente,
    # senão alguns proxies/navegadores bloqueiam o getUserMedia.
    add_header Permissions-Policy   "camera=(self), microphone=(self), display-capture=(self), fullscreen=(self), picture-in-picture=(self), screen-wake-lock=(self)" always;

    # CSP: libera só o que o app usa de fato.
    #  - unpkg/jsdelivr: PeerJS (controle remoto) e gerador de QR code.
    #  - api.anthropic.com: gerador de roteiro com IA (chave do próprio usuário).
    #  - *.peerjs.com / wss: sinalização do controle remoto entre dispositivos.
    #  - blob:/mediastream:: pré-visualização da câmera e download da gravação.
    # Usa um servidor PeerJS próprio? Acrescente o domínio dele em connect-src.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; font-src 'self' data:; connect-src 'self' https://api.anthropic.com https://*.peerjs.com wss://*.peerjs.com blob:; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'" always;

    # --- Rotas --------------------------------------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Tipos que o mime.types padrão do nginx não cobre. Um bloco `types` aqui
    # substituiria o mapa inteiro, então cada extensão ganha o seu default_type.
    location ~* \.webmanifest$ {
        default_type application/manifest+json;
    }
    location ~* \.mjs$ {
        default_type text/javascript;
    }

    location / {
        # Aceita /remote e /output além de /remote.html e /output.html.
        try_files $uri $uri.html $uri/ =404;
    }
}
