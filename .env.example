# Copie para .env e preencha. Usado por `docker compose up`.

# --- Contas da equipe -------------------------------------------------------
# Preencha para ativar login e a biblioteca compartilhada. O administrador
# entra com estes dados e cria as contas das outras pessoas dentro do app.
# Deixe em branco e o app volta a ser 100% local, sem login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Gerador de roteiro com IA ---------------------------------------------
# A chave fica no servidor: o navegador nunca a recebe.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_MODEL=            # vazio = melhor modelo disponível na conta
# AI_RATE_PER_MIN=10   # gerações por IP por minuto
